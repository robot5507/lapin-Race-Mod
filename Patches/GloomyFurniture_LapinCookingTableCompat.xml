<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>GloomyFurniture</li>
      <li>Gloomy Furniture</li>
    </mods>

    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>

        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="LP_LapinCookingTable"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
          <value>
            <li>GL_Cupboard</li>
            <li>GL_TablewareShelf</li>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="LP_ElectricStove"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
          <value>
            <li>GL_Cupboard</li>
            <li>GL_TablewareShelf</li>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>