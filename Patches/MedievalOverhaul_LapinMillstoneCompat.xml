<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Medieval Overhaul</li>
    </mods>

    <match Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>
<RecipeDef>
  <defName>LP_Mill_MedievalOverhaulFlour</defName>
  <label>중세식 밀 제분하기</label>
  <description>중세식 밀을 라핀 맷돌로 갈아 밀가루를 만든다.</description>
  <jobString>중세식 밀을 제분하는 중</jobString>

  <workAmount>100</workAmount>
  <workSpeedStat>CookSpeed</workSpeedStat>
  <effectWorking>Cook</effectWorking>
  <soundWorking>Recipe_Smith</soundWorking>

  <ingredients>
    <li>
      <filter>
        <categories>
          <li>DankPyon_Cereal</li>
        </categories>
      </filter>
      <count>4</count>
    </li>
  </ingredients>

  <products>
    <DankPyon_Flour>1</DankPyon_Flour>
  </products>

  <recipeUsers>
    <li>LapinMillstone</li>
  </recipeUsers>

  <allowMixingIngredients>false</allowMixingIngredients>
  <workSkill>Cooking</workSkill>
</RecipeDef>

<RecipeDef>
  <defName>LP_Mill_MedievalOverhaulFlourBulk</defName>
  <label>중세식 밀 제분하기 x10</label>
  <description>중세식 밀을 라핀 맷돌로 갈아 밀가루를 대량 생산한다.</description>
  <jobString>중세식 밀을 대량 제분하는 중</jobString>

  <workAmount>800</workAmount>
  <workSpeedStat>CookSpeed</workSpeedStat>
  <effectWorking>Cook</effectWorking>
  <soundWorking>Recipe_Smith</soundWorking>

  <ingredients>
    <li>
      <filter>
        <categories>
          <li>DankPyon_Cereal</li>
        </categories>
      </filter>
      <count>40</count>
    </li>
  </ingredients>

  <products>
    <DankPyon_Flour>10</DankPyon_Flour>
  </products>

  <recipeUsers>
    <li>LapinMillstone</li>
  </recipeUsers>

  <allowMixingIngredients>false</allowMixingIngredients>
  <workSkill>Cooking</workSkill>
</RecipeDef>
        

      </value>
    </match>
  </Operation>

</Patch>