<RecipeDef ParentName="CookMealBase">
  <defName>Make_LP_Consomme</defName>
  <label>라핀 콩소메 만들기</label>
  <jobString>라핀식 콩소메를 생산합니다.</jobString>

  <workAmount>700</workAmount>
  <workSpeedStat>CookSpeed</workSpeedStat>
  <effectWorking>Cook</effectWorking>
  <soundWorking>Recipe_Brewing</soundWorking>

  <recipeUsers>
     <li>LP_LapinCookingTable</li>
   <li>LP_ElectricStove</li>
  </recipeUsers>

  <ingredients>
    <li>
      <filter>
        <categories>
          <li>MeatRaw</li>
        </categories>
      </filter>
      <count>5</count>
    </li>

    <li>
      <filter>
        <categories>
          <li>PlantFoodRaw</li>
        </categories>
      </filter>
      <count>5</count>
    </li>

    <li>
      <filter>
        <categories>
          <li>EggsFertilized</li>
          <li>EggsUnfertilized</li>
        </categories>
      </filter>
      <count>1</count>
    </li>
  </ingredients>

  <fixedIngredientFilter>
    <categories>
      <li>MeatRaw</li>
      <li>PlantFoodRaw</li>
      <li>EggsFertilized</li>
      <li>EggsUnfertilized</li>
    </categories>
  </fixedIngredientFilter>

  <products>
    <LP_Consomme>10</LP_Consomme>
  </products>
 <skillRequirements>
      <Cooking>5</Cooking>
    </skillRequirements>
  <researchPrerequisite>LP_LapinCookingKnowhow</researchPrerequisite>
</RecipeDef>

</Defs>