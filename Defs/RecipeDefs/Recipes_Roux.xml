<?xml version="1.0" encoding="utf-8"?>
<Defs>

<RecipeDef ParentName="CookMealBase">
  <defName>Make_LP_Roux</defName>
  <label>루 만들기</label>
  <jobString>수프를 만들수 있는 기본적인 루를 생산합니다.</jobString>

  <workAmount>700</workAmount>
  <workSpeedStat>CookSpeed</workSpeedStat>
  <effectWorking>Cook</effectWorking>
  <soundWorking>Recipe_Brewing</soundWorking>

  <recipeUsers>
     <li>LP_LapinCookingTable</li>
   <li>LP_ElectricStove</li>
  </recipeUsers>

  <ingredients>
    <li>
      <filter>
        <thingDefs>
         <li>Milk</li>
        </thingDefs>
      </filter>
      <count>1</count>
    </li>
    <li>
        <filter>
          <thingDefs>
            <li>RawLapinFlour</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
          <li>
        <filter>
          <thingDefs>
            <li>LP_Butter</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    
  </ingredients>

  <fixedIngredientFilter>
    <thingDefs>
      <li>Milk</li>
    </thingDefs>
    <thingDefs>
      <li>RawLapinFlour</li>
    </thingDefs>
    <thingDefs>
      <li>LP_Butter</li>
    </thingDefs>
  </fixedIngredientFilter>

  <products>
    <LP_Roux>15</LP_Roux>
  </products>
   <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
  <researchPrerequisite>LP_LapinAdvancedCookingKnowhow</researchPrerequisite>
</RecipeDef>

