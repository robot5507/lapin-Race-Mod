<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef>
    <defName>Make_LP_AutomatonCore</defName>

    <label>오토마톤 사고핵 조립</label>

    <description>보존된 인간의 뇌와 정밀 기계 부품을 결합하여 라핀 오토마톤의 사고핵을 제작합니다.</description>

    <jobString>오토마톤 사고핵을 조립하는 중</jobString>

    <workAmount>5000</workAmount>

    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>

    <effectWorking>Smith</effectWorking>

    <soundWorking>Recipe_Machining</soundWorking>

    <workSkill>Crafting</workSkill>

    <recipeUsers>
      <li>LP_AutomatonWorkbench</li>
    </recipeUsers>

    <ingredients>

      <!-- 인간 뇌 -->
      <li>
        <filter>
          <thingDefs>
            <li>LP_LapinBrain</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>

      <!-- 강철 -->
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>60</count>
      </li>

      <!-- 산업 부품 -->
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>

      <!-- 금 -->
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>

    </ingredients>

    <fixedIngredientFilter>

      <thingDefs>
        <li>LP_LapinBrain</li>
        <li>Steel</li>
        <li>ComponentIndustrial</li>
        <li>Gold</li>
      </thingDefs>

    </fixedIngredientFilter>

    <products>
      <LP_AutomatonCore>1</LP_AutomatonCore>
    </products>

    <skillRequirements>
      <Crafting>8</Crafting>
      <Intellectual>4</Intellectual>
    </skillRequirements>

    <researchPrerequisite>LP_LapinAutomatonEngineering</researchPrerequisite>
    <unfinishedThingDef>UnfinishedAutomatonCore</unfinishedThingDef>

  </RecipeDef>
