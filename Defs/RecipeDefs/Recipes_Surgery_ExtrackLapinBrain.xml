  </ingredients>

  <fixedIngredientFilter>
    <thingDefs>
      <li>MedicineHerbal</li>
      <li>MedicineIndustrial</li>
      <li>MedicineUltratech</li>
    </thingDefs>
  </fixedIngredientFilter>

  <skillRequirements>
    <Medicine>8</Medicine>
  </skillRequirements>
