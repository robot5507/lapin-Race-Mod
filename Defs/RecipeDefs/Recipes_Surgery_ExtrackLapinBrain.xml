  <jobString>뇌를 적출하는 중</jobString>

  <workerClass>LapinRace.RecipeWorker_ExtractLapinBrain</workerClass>

  <workAmount>2500</workAmount>
  <surgerySuccessChanceFactor>0.75</surgerySuccessChanceFactor>
