      <filter>
        <thingDefs>
          <li>Milk</li>
        </thingDefs>
      </filter>
      <count>50</count>
    </li>
  </ingredients>

  <products>
    <LP_Cream>10</LP_Cream>
  </products>

  <recipeUsers>
    <li>LapinButterChurn</li>
  </recipeUsers>

  <allowMixingIngredients>false</allowMixingIngredients>
  <workSkill>Cooking</workSkill>

  <skillRequirements>
