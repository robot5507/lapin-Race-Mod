<Defs>
<ThingDef ParentName="MealBase">
  <defName>LP_CreamSoup</defName>
  <label>라핀 크림수프</label>
  <description>라핀식 크림수프.</description>

  <graphicData>
    <texPath>Things/Item/LP_creamsoup</texPath>
   <graphicClass>Graphic_Single</graphicClass>
    <drawSize>0.8</drawSize>
  </graphicData>

  <statBases>
    <MarketValue>2.2</MarketValue>
    <Mass>0.45</Mass>
    <Nutrition>0.9</Nutrition>
    <DeteriorationRate>6</DeteriorationRate>
  </statBases>

  <ingestible>
    <foodType>Meal</foodType>
    <preferability>MealFine</preferability>
    <baseIngestTicks>220</baseIngestTicks>
    <ingestCommandString>수프 식사</ingestCommandString>
    <ingestReportString>라핀식 크림수프를 먹고 있습니다.</ingestReportString>
    <tasteThought>LP_Lapin_Soup_Ate</tasteThought>

    
  </ingestible>
<stackLimit>10</stackLimit>

</ThingDef>

