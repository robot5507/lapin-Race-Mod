<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <WorkGiverDef>
        <defName>UseLapinMillstone</defName>
        <label>라핀 맷돌에서 밀가루를 만듭니다.</label>
        <giverClass>WorkGiver_DoBill</giverClass>
        <workType>Cooking</workType>
        <priorityInType>100</priorityInType>
        <fixedBillGiverDefs>
            <li>LapinMillstone</li>
        </fixedBillGiverDefs>
        <verb>제분</verb>
        <gerund>제분하기</gerund>
        <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <WorkGiverDef>
        <defName>UseLapinButterChurn</defName>
        <label>라핀 버터 제조기를 사용합니다.</label>
        <giverClass>WorkGiver_DoBill</giverClass>
        <workType>Cooking</workType>
        <priorityInType>100</priorityInType>
        <fixedBillGiverDefs>
            <li>LapinButterChurn</li>
        </fixedBillGiverDefs>
        <verb>제조</verb>
        <gerund>제조하기</gerund>
        <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

    <WorkGiverDef>
