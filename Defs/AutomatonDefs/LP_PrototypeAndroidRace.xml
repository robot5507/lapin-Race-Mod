<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseMechanoid">
    <defName>LP_PrototypeAndroidRace</defName>
    <label>시제형 안드로이드 오토마톤</label>
    <description>라핀 기술자들이 만든 초기형 작업 안드로이드입니다. 운반 작업만 수행할 수 있습니다.</description>

    <recipes Inherit="False">
</recipes>



    <statBases>
      <MoveSpeed>4.2</MoveSpeed>
      <MarketValue>1200</MarketValue>
      <Mass>80</Mass>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
    </statBases>

    <race>
      <intelligence>ToolUser</intelligence>

      <thinkTreeMain>LP_PrototypeAndroidThinkTree</thinkTreeMain>

      <body>Human</body>
      <fleshType>Mechanoid</fleshType>

      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <lifeExpectancy>500</lifeExpectancy>

      <foodType>None</foodType>
      <needsRest>false</needsRest>

      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>

   <comps Inherit="False">
  <li Class="LapinRace.CompProperties_PrototypeAndroidWorkControl"/>

  <li Class="LapinRace.CompProperties_PrototypeAndroidFuel">
    <maxEnergy>100</maxEnergy>
    <initialEnergy>50</initialEnergy>
    <chemfuelToEnergy>10</chemfuelToEnergy>
    <energyDrainPerTick>0.00035</energyDrainPerTick>
    <autoRefuelThreshold>0.3</autoRefuelThreshold>
    <fuelDefName>Chemfuel</fuelDefName>
  </li>

  <li Class="LapinRace.CompProperties_AutomatonMaintenance">
    <repairAmountPerComponent>15</repairAmountPerComponent>
  </li>
</comps>

    <inspectorTabs Inherit="False">
      <li>ITab_Pawn_Health</li>
      <li>ITab_Pawn_Needs</li>
    </inspectorTabs>

    <butcherProducts>
      <Steel>5</Steel>
    </butcherProducts>

  </ThingDef>


  <PawnKindDef>
    <defName>LP_PrototypeAndroid</defName>
    <label>시제형 안드로이드 오토마톤</label>
    <race>LP_PrototypeAndroidRace</race>

    <combatPower>30</combatPower>
    <isFighter>false</isFighter>
    <wildGroupSize>0</wildGroupSize>

    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Automatons/PrototypeAndroid</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.17,1.17)</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>

    <weaponMoney>
      <min>0</min>
      <max>0</max>
    </weaponMoney>

    <apparelMoney>
      <min>0</min>
      <max>0</max>
    </apparelMoney>
  </PawnKindDef>

</Defs>