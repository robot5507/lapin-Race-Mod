<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef>
    <defName>LP_AutomatonTank_Item</defName>
    <label>비활성화된 오토마톤 전차</label>
    <description>아직 기동되지 않은 라핀 오토마톤 전차입니다. 완성 직후 자동으로 활성화됩니다.</description>

    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <selectable>true</selectable>

    <graphicData>
      <texPath>Things/Pawn/Automatons/LP_Tank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5,3.5)</drawSize>
    </graphicData>

    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>500</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
    </statBases>

    <useHitPoints>true</useHitPoints>
    <altitudeLayer>Item</altitudeLayer>
    <tickerType>Normal</tickerType>

    <comps>
      <li Class="LapinRace.CompProperties_ActivateAutomatonTank"/>
    </comps>
  </ThingDef>

</Defs>