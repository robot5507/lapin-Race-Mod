<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseGun">
    <defName>LP_AutomatonCannonGun</defName>
    <label>오토마톤 전차포</label>
    <description>오토마톤 전차에 내장되는 중구경 화포입니다. 일반 폰이 사용하기에는 지나치게 크고 무겁습니다.</description>
    <smeltable>false</smeltable>

    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Industrial</techLevel>
    <weaponTags>
      <li>LP_AutomatonTankCannon</li>
    </weaponTags>

    <graphicData>
      <texPath>Things/AutomatonWeapons/LP_AutomatonCannonGun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.0,2.0)</drawSize>
    </graphicData>

    <statBases>
      <MarketValue>500</MarketValue>
      <Mass>35</Mass>
      <AccuracyTouch>0.40</AccuracyTouch>
      <AccuracyShort>0.65</AccuracyShort>
      <AccuracyMedium>0.75</AccuracyMedium>
      <AccuracyLong>0.65</AccuracyLong>
      <RangedWeapon_Cooldown>4.5</RangedWeapon_Cooldown>
    </statBases>

    <verbs>
      <li>
        <verbClass>LapinRace.Verb_ShootAutomatonCannon</verbClass>
        <hasStandardCommand>true</hasStandardCommand>

        <defaultProjectile>Bullet_LP_AutomatonCannon</defaultProjectile>

        <range>34.9</range>
        <minRange>4.0</minRange>
        <warmupTime>2.5</warmupTime>

        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>20</ticksBetweenBurstShots>

        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>14</muzzleFlashScale>

        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>true</canTargetPawns>
          <canTargetBuildings>true</canTargetBuildings>
        </targetParams>
      </li>
    </verbs>

  
  </ThingDef>

</Defs>