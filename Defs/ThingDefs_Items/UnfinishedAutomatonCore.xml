<?xml version="1.0" encoding="utf-8"?>
<Defs>

   <ThingDef>
    <defName>UnfinishedAutomatonCore</defName>
    <label>미완성 오토마톤 사고핵</label>
    <description>아직 조립이 끝나지 않은 오토마톤 사고핵입니다.</description>
    <thingClass>UnfinishedThing</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <altitudeLayer>Item</altitudeLayer>

    <graphicData>
      <texPath>Things/Item/UnfinishedAutomatonCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9,0.9)</drawSize>
    </graphicData>

    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <Mass>3</Mass>
    </statBases>
  </ThingDef>

